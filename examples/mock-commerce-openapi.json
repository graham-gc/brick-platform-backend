{
  "openapi": "3.0.3",
  "info": {
    "title": "Mock Commerce API",
    "description": "A deterministic sample application for API workflow testing. The intended flow is login, list products, create an order, pay for it, and verify the final order state.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:9090/api/v1",
      "description": "Local mock application"
    }
  ],
  "tags": [
    { "name": "System", "description": "Service health" },
    { "name": "Authentication", "description": "User authentication" },
    { "name": "Products", "description": "Product catalogue" },
    { "name": "Orders", "description": "Order lifecycle" },
    { "name": "Payments", "description": "Order payment" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Check service health",
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" },
                "example": {
                  "status": "UP",
                  "service": "mock-commerce",
                  "version": "1.0.0"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Log in and obtain an access token",
        "operationId": "login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" },
              "example": {
                "username": "demo.user",
                "password": "demo-password"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login succeeded",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" },
                "example": {
                  "code": "SUCCESS",
                  "message": "Login successful",
                  "data": {
                    "accessToken": "mock-access-token",
                    "tokenType": "Bearer",
                    "expiresIn": 3600,
                    "userId": "usr-1001"
                  },
                  "traceId": "trace-login-001"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/products": {
      "get": {
        "tags": ["Products"],
        "summary": "List available products",
        "operationId": "listProducts",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "models" }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "Product page",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductListResponse" },
                "example": {
                  "code": "SUCCESS",
                  "message": "Products retrieved",
                  "data": {
                    "page": 1,
                    "pageSize": 20,
                    "total": 2,
                    "items": [
                      {
                        "id": "prd-1001",
                        "name": "Model Kit Starter Set",
                        "category": "models",
                        "price": 49.90,
                        "currency": "NZD",
                        "stock": 12
                      },
                      {
                        "id": "prd-1002",
                        "name": "Precision Craft Tool Set",
                        "category": "tools",
                        "price": 29.50,
                        "currency": "NZD",
                        "stock": 8
                      }
                    ]
                  },
                  "traceId": "trace-products-001"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/products/{productId}": {
      "get": {
        "tags": ["Products"],
        "summary": "Get product details",
        "operationId": "getProduct",
        "parameters": [
          { "$ref": "#/components/parameters/ProductId" }
        ],
        "responses": {
          "200": {
            "description": "Product details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/orders": {
      "post": {
        "tags": ["Orders"],
        "summary": "Create an order",
        "operationId": "createOrder",
        "parameters": [
          { "$ref": "#/components/parameters/RequestId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateOrderRequest" },
              "example": {
                "customerId": "usr-1001",
                "items": [
                  { "productId": "prd-1001", "quantity": 2 }
                ],
                "deliveryAddress": {
                  "line1": "5 Example Street",
                  "city": "Auckland",
                  "postcode": "1010",
                  "country": "NZ"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created",
            "headers": {
              "Location": {
                "description": "URL of the new order",
                "schema": { "type": "string", "example": "/api/v1/orders/ord-2001" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OrderResponse" },
                "example": {
                  "code": "SUCCESS",
                  "message": "Order created",
                  "data": {
                    "id": "ord-2001",
                    "customerId": "usr-1001",
                    "status": "PENDING_PAYMENT",
                    "currency": "NZD",
                    "totalAmount": 99.80,
                    "items": [
                      {
                        "productId": "prd-1001",
                        "productName": "Model Kit Starter Set",
                        "quantity": 2,
                        "unitPrice": 49.90
                      }
                    ],
                    "createdAt": "2026-08-14T10:00:00+12:00"
                  },
                  "traceId": "trace-order-001"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/orders/{orderId}": {
      "get": {
        "tags": ["Orders"],
        "summary": "Get an order",
        "operationId": "getOrder",
        "parameters": [
          { "$ref": "#/components/parameters/OrderId" }
        ],
        "responses": {
          "200": {
            "description": "Order details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OrderResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/orders/{orderId}/payments": {
      "post": {
        "tags": ["Payments"],
        "summary": "Pay for an order",
        "operationId": "payOrder",
        "parameters": [
          { "$ref": "#/components/parameters/OrderId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PaymentRequest" },
              "example": {
                "paymentMethod": "TEST_CARD",
                "amount": 99.80,
                "currency": "NZD"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment accepted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentResponse" },
                "example": {
                  "code": "SUCCESS",
                  "message": "Payment accepted",
                  "data": {
                    "paymentId": "pay-3001",
                    "orderId": "ord-2001",
                    "status": "PAID",
                    "amount": 99.80,
                    "currency": "NZD",
                    "paidAt": "2026-08-14T10:01:00+12:00"
                  },
                  "traceId": "trace-payment-001"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/orders/{orderId}/status": {
      "patch": {
        "tags": ["Orders"],
        "summary": "Update order status",
        "operationId": "updateOrderStatus",
        "parameters": [
          { "$ref": "#/components/parameters/OrderId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateOrderStatusRequest" },
              "example": { "status": "CANCELLED", "reason": "Customer request" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order status updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OrderResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "ProductId": {
        "name": "productId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "example": "prd-1001" }
      },
      "OrderId": {
        "name": "orderId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "example": "ord-2001" }
      },
      "RequestId": {
        "name": "X-Request-Id",
        "in": "header",
        "required": false,
        "schema": { "type": "string", "example": "req-0001" }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "example": "idem-0001" }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Request validation failed",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "code": "VALIDATION_ERROR",
              "message": "The request is invalid",
              "details": ["items[0].quantity must be greater than zero"],
              "traceId": "trace-error-400"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Access token is missing or invalid",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "code": "UNAUTHORIZED",
              "message": "A valid bearer token is required",
              "details": [],
              "traceId": "trace-error-401"
            }
          }
        }
      },
      "NotFound": {
        "description": "Requested resource was not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "code": "NOT_FOUND",
              "message": "The requested resource was not found",
              "details": [],
              "traceId": "trace-error-404"
            }
          }
        }
      },
      "Conflict": {
        "description": "Request conflicts with the current resource state",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "code": "STATE_CONFLICT",
              "message": "The operation is not valid for the current order state",
              "details": [],
              "traceId": "trace-error-409"
            }
          }
        }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status", "service", "version"],
        "properties": {
          "status": { "type": "string", "enum": ["UP"] },
          "service": { "type": "string" },
          "version": { "type": "string" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "minLength": 1 },
          "password": { "type": "string", "format": "password", "minLength": 1 }
        }
      },
      "TokenData": {
        "type": "object",
        "required": ["accessToken", "tokenType", "expiresIn", "userId"],
        "properties": {
          "accessToken": { "type": "string" },
          "tokenType": { "type": "string", "enum": ["Bearer"] },
          "expiresIn": { "type": "integer", "format": "int64" },
          "userId": { "type": "string" }
        }
      },
      "Product": {
        "type": "object",
        "required": ["id", "name", "category", "price", "currency", "stock"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "price": { "type": "number", "format": "double", "minimum": 0 },
          "currency": { "type": "string", "enum": ["NZD"] },
          "stock": { "type": "integer", "minimum": 0 }
        }
      },
      "ProductPage": {
        "type": "object",
        "required": ["page", "pageSize", "total", "items"],
        "properties": {
          "page": { "type": "integer" },
          "pageSize": { "type": "integer" },
          "total": { "type": "integer" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Product" }
          }
        }
      },
      "Address": {
        "type": "object",
        "required": ["line1", "city", "postcode", "country"],
        "properties": {
          "line1": { "type": "string" },
          "line2": { "type": "string" },
          "city": { "type": "string" },
          "postcode": { "type": "string" },
          "country": { "type": "string", "minLength": 2, "maxLength": 2 }
        }
      },
      "OrderItemRequest": {
        "type": "object",
        "required": ["productId", "quantity"],
        "properties": {
          "productId": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 20 }
        }
      },
      "CreateOrderRequest": {
        "type": "object",
        "required": ["customerId", "items", "deliveryAddress"],
        "properties": {
          "customerId": { "type": "string" },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/OrderItemRequest" }
          },
          "deliveryAddress": { "$ref": "#/components/schemas/Address" }
        }
      },
      "OrderItem": {
        "type": "object",
        "required": ["productId", "productName", "quantity", "unitPrice"],
        "properties": {
          "productId": { "type": "string" },
          "productName": { "type": "string" },
          "quantity": { "type": "integer" },
          "unitPrice": { "type": "number", "format": "double" }
        }
      },
      "Order": {
        "type": "object",
        "required": ["id", "customerId", "status", "currency", "totalAmount", "items", "createdAt"],
        "properties": {
          "id": { "type": "string" },
          "customerId": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["PENDING_PAYMENT", "PAID", "PROCESSING", "SHIPPED", "COMPLETED", "CANCELLED"]
          },
          "currency": { "type": "string", "enum": ["NZD"] },
          "totalAmount": { "type": "number", "format": "double" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/OrderItem" }
          },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "PaymentRequest": {
        "type": "object",
        "required": ["paymentMethod", "amount", "currency"],
        "properties": {
          "paymentMethod": { "type": "string", "enum": ["TEST_CARD", "BANK_TRANSFER"] },
          "amount": { "type": "number", "format": "double", "minimum": 0.01 },
          "currency": { "type": "string", "enum": ["NZD"] }
        }
      },
      "Payment": {
        "type": "object",
        "required": ["paymentId", "orderId", "status", "amount", "currency", "paidAt"],
        "properties": {
          "paymentId": { "type": "string" },
          "orderId": { "type": "string" },
          "status": { "type": "string", "enum": ["PAID", "DECLINED"] },
          "amount": { "type": "number", "format": "double" },
          "currency": { "type": "string", "enum": ["NZD"] },
          "paidAt": { "type": "string", "format": "date-time" }
        }
      },
      "UpdateOrderStatusRequest": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["PROCESSING", "SHIPPED", "COMPLETED", "CANCELLED"] },
          "reason": { "type": "string", "maxLength": 200 }
        }
      },
      "LoginResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/SuccessEnvelope" },
          {
            "type": "object",
            "properties": { "data": { "$ref": "#/components/schemas/TokenData" } }
          }
        ]
      },
      "ProductResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/SuccessEnvelope" },
          {
            "type": "object",
            "properties": { "data": { "$ref": "#/components/schemas/Product" } }
          }
        ]
      },
      "ProductListResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/SuccessEnvelope" },
          {
            "type": "object",
            "properties": { "data": { "$ref": "#/components/schemas/ProductPage" } }
          }
        ]
      },
      "OrderResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/SuccessEnvelope" },
          {
            "type": "object",
            "properties": { "data": { "$ref": "#/components/schemas/Order" } }
          }
        ]
      },
      "PaymentResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/SuccessEnvelope" },
          {
            "type": "object",
            "properties": { "data": { "$ref": "#/components/schemas/Payment" } }
          }
        ]
      },
      "SuccessEnvelope": {
        "type": "object",
        "required": ["code", "message", "data", "traceId"],
        "properties": {
          "code": { "type": "string", "enum": ["SUCCESS"] },
          "message": { "type": "string" },
          "data": { "type": "object" },
          "traceId": { "type": "string" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["code", "message", "traceId"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "details": {
            "type": "array",
            "items": { "type": "string" }
          },
          "traceId": { "type": "string" }
        }
      }
    }
  },
  "security": [
    { "bearerAuth": [] }
  ]
}
